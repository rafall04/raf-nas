# RAF NAS — contoh environment. Salin ke `.env` (jangan commit .env).
# API bind ke localhost saja; hanya reverse proxy yang menghadap LAN di 443/80.
API_HOST=127.0.0.1
API_PORT=4000

# PostgreSQL — dipakai mulai milestone DB. Port 5432 sudah dipastikan bebas di server produksi.
DATABASE_URL=postgresql://rafnas:CHANGE_ME@127.0.0.1:5432/rafnas?schema=public
